# Public Git hygiene for V-LiSEMOD.
# Keep application source, templates, static assets, reviewer source, frozen
# manifests/inputs/references, and the deliberately small fixture coordinates.

# ------------------------------
# Secrets and local configuration
# ------------------------------
.env
.env.*
!.env.example
.flaskenv
.envrc
*.local
*.secret
*.secrets
secrets/
private/
credentials/
*.key
*.pem
*.crt
*.p12
*.pfx
*.token
*.credentials
*.creds
*.cfg.local
*.ini.local

# ------------------------------
# V-LiSEMOD downloaded PDB corpus
# ------------------------------
# Do not use a global *.cif rule: the reviewer 3EKY fixture is source data.
/PDB_FILES/
/CIF_DATABASE_REBUILD/PDB_FILES/
/CIF_DATABASE_REBUILD/inputs/PDB_FILES/
/REVIEWER_REPRODUCIBILITY/PDB_FILES/
.download_cache/
**/.download_cache/
*.part

# ------------------------------
# CIF rebuild runtime outputs
# ------------------------------
/CIF_DATABASE_REBUILD/outputs/
/CIF_DATABASE_REBUILD/logs/
/CIF_DATABASE_REBUILD/temp/
/CIF_DATABASE_REBUILD/tmp/
/CIF_DATABASE_REBUILD/scratch/
/CIF_DATABASE_REBUILD/arpeggio/
/CIF_DATABASE_REBUILD/*.zip
/CIF_DATABASE_REBUILD/*.tar
/CIF_DATABASE_REBUILD/*.tar.gz

# ------------------------------
# Reviewer reproduction runtime
# ------------------------------
/REVIEWER_REPRODUCIBILITY/outputs/*
!/REVIEWER_REPRODUCIBILITY/outputs/.gitkeep
/VLiSEMOD_Reviewer_Reproducibility_*.zip
/reviewer_audit_*/

# ------------------------------
# SQLite transient files and generated checkpoints
# ------------------------------
*.db-wal
*.db-shm
*.db-journal
/viral_data*.db
/CIF_DATABASE_REBUILD/*.db
/REVIEWER_REPRODUCIBILITY/outputs/*.db
*_checkpoint*.db
*_CHECKPOINT*.db
*_backup*.db
*_BACKUP*.db
*_PRE_*.db
*_POST_*.db
*_WEB_*.db

# ------------------------------
# Generated application data, logs, and archives
# ------------------------------
/outputs/
/output_csvs/
/pml_sessions/
/temp/
/tmp/
/scratch/
/users_info/
/exports/
/downloads/
/reports/
/generated_exports/
/generated_zip_bundles/
/generated_data/
/generated_training_data/
/training_runs/
/tokenized_datasets/
/static/charts/
/static/coordinate_cache/
/static/ligand_sdf_cache/
/static/ligand_images/
*.log
/logs/
server.out
nohup.out
*.pid
/backups/
/app_PRE_*.py
/templates/*_PRE_*.html
/*.zip
/*.tar
/*.tar.gz
/*.tgz
/*.7z

